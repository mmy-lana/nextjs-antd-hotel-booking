{
  "name": "nextjs-antd-hotel-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:domain": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/verify/register-aliases.mjs ./scripts/verify/domain-suite.mjs",
    "verify:ui": "node ./scripts/verify/ui-suite.mjs",
    "verify": "pnpm run typecheck && pnpm run verify:domain && pnpm run verify:ui"
  },
  "dependencies": {
    "@ant-design/icons": "latest",
    "@ant-design/nextjs-registry": "latest",
    "antd": "latest",
    "dayjs": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
